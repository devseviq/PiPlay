<UserControl x:Class="PiPlay.Controls.AccentColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:PiPlay.Theme"
             MinWidth="320"
             SnapsToDevicePixels="True">
  <StackPanel>
    <Grid x:Name="ReadabilityRow" Margin="0,0,0,10" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="ReadabilityWarning"
                 Text="Enter a valid 6-digit hex color."
                 Foreground="{DynamicResource DangerPin}" TextWrapping="Wrap"
                 VerticalAlignment="Center" Visibility="Collapsed" />
      <Button x:Name="UseNearestReadableButton" Grid.Column="1"
              Style="{StaticResource DarkButton}" Content="Use default"
              Click="UseNearestReadableButton_Click" Visibility="Collapsed"
              ToolTip="Use the default accent color"
              AutomationProperties.Name="Use default accent" />
    </Grid>

    <Grid Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="152" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Width="148" Height="148">
        <Image x:Name="HueSatDisc" Stretch="Fill"
               ToolTip="Choose accent hue and saturation"
               AutomationProperties.Name="Accent hue and saturation" />
        <Canvas IsHitTestVisible="False">
          <Ellipse x:Name="HueSatThumb" Width="12" Height="12"
                   Stroke="{DynamicResource TextPrimary}" StrokeThickness="2"
                   Fill="Transparent" />
        </Canvas>
      </Grid>

      <StackPanel Grid.Column="2">
        <TextBlock Text="Brightness" FontSize="12"
                   Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
        <Slider Style="{StaticResource DarkSlider}" x:Name="ValueSlider" Minimum="0" Maximum="1" SmallChange="0.01" LargeChange="0.1"
                IsMoveToPointEnabled="True" ValueChanged="ValueSlider_ValueChanged"
                ToolTip="Accent brightness"
                AutomationProperties.Name="Accent brightness" />

        <Grid Margin="0,10,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Red" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
          <TextBox Grid.Row="1" x:Name="RInput" Grid.Column="0" Style="{StaticResource DarkTextBox}"
                   TextChanged="RgbInput_TextChanged" ToolTip="Red channel 0-255"
                   AutomationProperties.Name="Red channel" />
          <TextBlock Grid.Column="2" Text="Green" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
          <TextBox Grid.Row="1" x:Name="GInput" Grid.Column="2" Style="{StaticResource DarkTextBox}"
                   TextChanged="RgbInput_TextChanged" ToolTip="Green channel 0-255"
                   AutomationProperties.Name="Green channel" />
          <TextBlock Grid.Column="4" Text="Blue" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,4" />
          <TextBox Grid.Row="1" x:Name="BInput" Grid.Column="4" Style="{StaticResource DarkTextBox}"
                   TextChanged="RgbInput_TextChanged" ToolTip="Blue channel 0-255"
                   AutomationProperties.Name="Blue channel" />
        </Grid>

        <TextBox x:Name="HexInput" Style="{StaticResource DarkTextBox}" Margin="0,8,0,0"
                 TextChanged="HexInput_TextChanged" ToolTip="Hex accent color"
                 AutomationProperties.Name="Hex accent color" />

        <Grid Margin="0,8,0,0">
          <Border x:Name="PreviewSwatch" Width="26" Height="26"
                  CornerRadius="{DynamicResource RadiusSwatch}"
                  BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                  ToolTip="Stored color; very dark chrome cues are lifted for visibility"
                  AutomationProperties.Name="Stored color preview" />
        </Grid>
      </StackPanel>
    </Grid>

    <ItemsControl x:Name="PresetRow" Margin="0,0,0,10">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type theme:ThemeAccentOption}">
          <Button Style="{StaticResource DarkButton}" Padding="4" Margin="0,0,6,0"
                  Click="Preset_Click"
                  ToolTip="{Binding DisplayName}"
                  AutomationProperties.Name="{Binding DisplayName}">
            <Border Width="22" Height="22" CornerRadius="{DynamicResource RadiusSwatch}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    Background="{Binding HexColor}" />
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </StackPanel>
</UserControl>
