<Window x:Class="PiPlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PiPlay"
        Height="760" Width="1180"
        MinHeight="480" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="{DynamicResource AppBackgroundWash}"
        UseLayoutRounding="False"
        SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
  <!-- Custom thin title bar with native resize (spec 5.5). AllowsTransparency stays False:
       a transparent WPF window is incompatible with the HwndHost WebView2 (airspace). -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="42"
                  ResizeBorderThickness="12"
                  CornerRadius="0"
                  GlassFrameThickness="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="42" />
      <RowDefinition Height="50" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Title bar -->
    <Grid x:Name="TitleBar" Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Background-only opacity: the existing Active opacity preference reaches the Source title
           bar without fading its text/buttons or the WebView2 browsing surface. At 100% this is the
           exact pre-change gradient. -->
      <Border x:Name="MainBarBackdrop" Grid.ColumnSpan="2" IsHitTestVisible="False">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="{DynamicResource AccentShellTintColor}" Offset="0" />
            <GradientStop Color="{DynamicResource SurfaceBaseColor}" Offset="0.80" />
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
        <Image Source="Assets/piplay.ico" Width="20" Height="20" Margin="0,0,10,0" />
        <TextBlock x:Name="TitleText" Text="PiPlay" FontSize="14" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
        <TextBlock x:Name="PinnedHint" Text="• Pinned" FontSize="12" Margin="10,0,0,0"
                   Foreground="{DynamicResource AccentPrimary}" VerticalAlignment="Center"
                   Visibility="Collapsed" />
      </StackPanel>

      <!-- Caption buttons must opt out of the draggable caption area. -->
      <!-- Keep the outer resize band clear so the top-right diagonal is not hidden under Close. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0"
                  WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="SettingsButton_Click"
                Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" />
        <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Click="MinimizeButton_Click"
                Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" />
        <!-- State-neutral name: the glyph flips Maximize/Restore in code, the name must stay true. -->
        <Button x:Name="MaximizeButton" Style="{StaticResource IconButton}" Click="MaximizeButton_Click"
                Content="&#xE922;" ToolTip="Maximize" AutomationProperties.Name="Maximize or restore" />
        <Button x:Name="CloseButton" Style="{StaticResource CloseIconButton}" Click="CloseButton_Click"
                Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" />
      </StackPanel>
    </Grid>

    <!-- Toolbar: navigation + URL/search + profiles + Pin + Pop out -->
    <Grid x:Name="SourceToolbar" Grid.Row="1" Background="{DynamicResource AppBackgroundWash}"
          WindowChrome.IsHitTestVisibleInChrome="True"
          SizeChanged="SourceToolbar_SizeChanged">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />   <!-- nav -->
        <ColumnDefinition Width="*" />       <!-- URL / search -->
        <ColumnDefinition Width="Auto" />   <!-- profiles -->
        <ColumnDefinition Width="Auto" />   <!-- Pin -->
        <ColumnDefinition Width="Auto" />   <!-- Auto -->
        <ColumnDefinition Width="Auto" />   <!-- Show existing Popout -->
        <ColumnDefinition Width="Auto" />   <!-- Transfer video -->
      </Grid.ColumnDefinitions>

      <StackPanel x:Name="SourceNavigationGroup" Grid.Column="0" Orientation="Horizontal"
                  Margin="8,0,4,0" VerticalAlignment="Center">
        <Button x:Name="BackButton" Style="{StaticResource AccentIconButton}" Click="BackButton_Click"
                Content="&#xE72B;" ToolTip="Back" AutomationProperties.Name="Back" />
        <Button x:Name="ReloadButton" Style="{StaticResource AccentIconButton}" Click="ReloadButton_Click"
                Content="&#xE72C;" ToolTip="Reload" AutomationProperties.Name="Reload" />
        <Button x:Name="HomeButton" Style="{StaticResource AccentIconButton}" Click="HomeButton_Click"
                Content="&#xE80F;" ToolTip="YouTube home" AutomationProperties.Name="YouTube home" />
      </StackPanel>

      <TextBox x:Name="UrlBox" Grid.Column="1" Style="{StaticResource DarkTextBox}"
               Margin="6,9" VerticalAlignment="Center"
               KeyDown="UrlBox_KeyDown"
               ToolTip="Paste a YouTube URL or type to search, then press Enter"
               AutomationProperties.Name="URL or search" />

      <StackPanel x:Name="SourceProfileGroup" Grid.Column="2" Orientation="Horizontal"
                  Margin="4,0" VerticalAlignment="Center">
        <ComboBox x:Name="ProfilesCombo" Style="{StaticResource DarkComboBox}" Width="140"
                  SelectionChanged="ProfilesCombo_SelectionChanged"
                  ToolTip="Saved profiles" AutomationProperties.Name="Saved profiles">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <!-- Row wash (docs/Theme_Preset_Differences.md): the row wears its OWN accent at the theme's
                   subtle alpha, behind the identity rail. Tag carries the theme-published alpha
                   so a live theme change reconverts, same trick as the rail's surface Tag. -->
              <Grid x:Name="ProfileIdentityRow" MinWidth="0"
                    Tag="{DynamicResource ProfileRowWashAlpha}">
                <Grid.Background>
                  <MultiBinding Converter="{StaticResource AccentWashBrushConverter}">
                    <Binding Path="AccentColor" />
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                  </MultiBinding>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ProfileIdentityColorRail" Width="4" MinHeight="16"
                        Margin="0,2,8,2" CornerRadius="{DynamicResource RadiusSwatch}"
                        Tag="{DynamicResource SurfaceHover}">
                  <Border.Background>
                    <MultiBinding Converter="{StaticResource ContrastBrushConverter}">
                      <Binding Path="AccentColor" />
                      <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding>
                  </Border.Background>
                </Border>
                <TextBlock x:Name="ProfileIdentityName" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
              </Grid>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button x:Name="ProfileActionsButton" Style="{StaticResource AccentIconButton}"
                Content="&#xE712;" ToolTip="Profile actions" Margin="2,0,0,0"
                Click="ProfileActionsButton_Click" AutomationProperties.Name="Profile actions">
          <Button.ContextMenu>
            <ContextMenu x:Name="ProfileActionsMenu" Style="{StaticResource DarkContextMenu}"
                         Placement="Bottom">
              <MenuItem x:Name="SaveProfileMenuItem" Style="{StaticResource DarkMenuItem}"
                        Header="_Save current page" Click="SaveProfileButton_Click"
                        AutomationProperties.Name="Save current page as profile">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="EditProfileMenuItem" Style="{StaticResource DarkMenuItem}"
                        Header="_Edit selected profile" Click="EditProfileButton_Click" IsEnabled="False"
                        AutomationProperties.Name="Edit selected profile">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </MenuItem.Icon>
              </MenuItem>
              <MenuItem x:Name="DeleteProfileMenuItem" Style="{StaticResource DarkMenuItem}"
                        Header="_Delete selected profile" Click="DeleteProfileButton_Click" IsEnabled="False"
                        AutomationProperties.Name="Delete selected profile">
                <MenuItem.Icon>
                  <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                </MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </Button.ContextMenu>
        </Button>
      </StackPanel>

      <ToggleButton x:Name="PinToggle" Grid.Column="3" Style="{StaticResource PinToggle}"
                    Margin="6,0" Content="&#xE840;" Click="PinToggle_Click"
                    ToolTip="Pin Source Window on top" AutomationProperties.Name="Pin Source Window on top" />

      <ToggleButton x:Name="AutoToggle" Grid.Column="4" Style="{StaticResource PinToggle}"
                    Margin="6,0" Content="&#xE768;" Click="AutoToggle_Click"
                    ToolTip="Automatically pop out videos when playback starts"
                    AutomationProperties.Name="Auto popout" />

      <!-- ADR-0005 recovery is deliberately separate from transfer: Show restores/focuses the
           existing player without closing it; the primary action moves playback in either direction. -->
      <Button x:Name="ShowPopoutButton" Grid.Column="5" Style="{StaticResource AccentIconButton}"
              Margin="2,0" Content="&#xE8A7;" Click="ShowPopoutButton_Click"
              Visibility="Collapsed" ToolTip="Show the existing Popout Player"
              AutomationProperties.Name="Show Popout Player" />

      <Button x:Name="PopOutButton" Grid.Column="6" Style="{StaticResource AccentButton}"
              Margin="6,6,10,6" Click="PopOutButton_Click" IsEnabled="False"
              ToolTip="Pop out the current video" AutomationProperties.Name="Pop out video">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="PopOutButtonIcon" Text="&#xE8A7;"
                     FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                     Foreground="{Binding Foreground, ElementName=PopOutButton}"
                     TextOptions.TextFormattingMode="Display"
                     TextOptions.TextHintingMode="Fixed"
                     TextOptions.TextRenderingMode="Grayscale"
                     VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock x:Name="PopOutButtonText" Text="Pop out video"
                     Foreground="{Binding Foreground, ElementName=PopOutButton}"
                     TextOptions.TextFormattingMode="Display"
                     TextOptions.TextHintingMode="Fixed"
                     TextOptions.TextRenderingMode="Grayscale"
                     VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- Content: browser + overlays. The letterbox pixels around the video wear the derived
         near-black room tint (docs/Theme_Preset_Differences.md), never a hard-coded black. -->
    <Grid x:Name="SourceLetterbox" Grid.Row="2" Background="{DynamicResource AccentLetterbox}">
      <!-- Resize inset band (REQ-WINDOW-02, overhaul Task 1): the WebView2 child HWND swallows
           WM_NCHITTEST, so the top-level window must own the edge pixels for the resize subclass
           to see them. Left/right/bottom margin == BorderlessResizeHitTestPolicy.ResizeBorderDip
           (the top band is the WPF title bar + toolbar). Maximized goes full-bleed: resize zones
           are inert there. XamlInvariantTests pins both values. -->
      <wv2:WebView2 x:Name="Browser">
        <wv2:WebView2.Style>
          <Style TargetType="{x:Type wv2:WebView2}">
            <Setter Property="Margin" Value="12,0,12,12" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}"
                           Value="Maximized">
                <Setter Property="Margin" Value="0" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </wv2:WebView2.Style>
      </wv2:WebView2>

      <!-- Tier-1 Source Placeholder: shown (and the WebView hidden) while popped out (spec 13.3). -->
      <Border x:Name="SourcePlaceholder" Background="{DynamicResource AccentLetterbox}" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="40"
                     Foreground="{DynamicResource AccentPrimary}" HorizontalAlignment="Center" />
          <TextBlock Text="Playing in Video Popout" FontSize="18" Margin="0,14,0,0"
                     Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
          <TextBlock Text="Ready to bring playback back here."
                     FontSize="12" Margin="0,6,0,0"
                     Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button x:Name="PlaceholderShowPopoutButton" Style="{StaticResource DarkButton}"
                    Content="Show Popout" Click="PlaceholderShowPopoutButton_Click"
                    ToolTip="Restore and focus the existing Popout Player"
                    AutomationProperties.Name="Show Popout Player" />
            <Button x:Name="PlaceholderBringBackButton" Style="{StaticResource AccentButton}"
                    Content="Bring video back" Margin="8,0,0,0"
                    Click="PlaceholderBringBackButton_Click"
                    ToolTip="Return playback to the Source Window"
                    AutomationProperties.Name="Bring video back" />
          </StackPanel>
          <!-- Non-blocking fallback note (Q-6): e.g. the mix/radio "popped out the current video
               only" reason, previously log-only. Lives on the SOURCE side by design - the popout
               ErrorBar is compact-error semantics and must not diverge the popout captures. -->
          <TextBlock x:Name="PlaceholderNoteText" FontSize="12" Margin="0,14,0,0" MaxWidth="420"
                     TextWrapping="Wrap" TextAlignment="Center" Visibility="Collapsed"
                     Foreground="{StaticResource AccentAmber}" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- WebView2 runtime-missing / init-failure recovery panel (spec 15.4, Q-6). -->
      <Border x:Name="RuntimeErrorPanel" Background="{DynamicResource AppBackground}" Visibility="Collapsed">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
          <TextBlock Text="WebView2 Runtime is required" FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" />
          <TextBlock x:Name="RuntimeErrorText" TextWrapping="Wrap" TextAlignment="Center"
                     FontSize="13" Margin="0,12,0,0" Foreground="{DynamicResource TextSecondary}"
                     Text="PiPlay needs the Microsoft Edge WebView2 Evergreen Runtime to display YouTube. Install it, then reopen PiPlay." />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
            <Button Content="Get WebView2 Runtime" Style="{StaticResource AccentButton}"
                    Click="DownloadRuntime_Click" />
            <Button Content="Retry" Style="{StaticResource DarkButton}" Margin="10,0,0,0"
                    Click="RetryRuntime_Click" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
