<!--
  PiPlay color tokens - spec section 5.2.
  Matte black, low-glow cyan/purple accents, utility-first dark UI.
  Each token is exposed as both a Color and a SolidColorBrush.

  The surface/border/text tokens are SEEDS for the default sharp-dark palette:
  ThemeResourceApplier replaces the brush (and Color) entries from the active preset's
  ThemePalette at startup and on theme change; consumers reference the brushes via
  DynamicResource so the restyle lands live. The seeds keep the design-time look correct
  and cover the pre-Apply instant.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!-- Sharp Dark palette seeds (docs/Theme_Preset_Differences.md): the darkest, coolest
       base. The warmer pre-theme tones now live on as the Minimal preset. -->
  <Color x:Key="AppBackgroundColor">#FF050609</Color>
  <Color x:Key="SurfaceBaseColor">#FF0B0E12</Color>
  <Color x:Key="SurfaceRaisedColor">#FF131820</Color>
  <Color x:Key="SurfaceHoverColor">#FF1E2630</Color>
  <Color x:Key="BorderSubtleColor">#FF181F29</Color>
  <Color x:Key="BorderStrongColor">#FF262F3D</Color>
  <Color x:Key="TextPrimaryColor">#FFF4F7FA</Color>
  <Color x:Key="TextSecondaryColor">#FF9AA2AD</Color>
  <Color x:Key="AccentCyanColor">#FF2BAED0</Color>
  <Color x:Key="AccentCyanLightColor">#FF5BE6FF</Color>
  <Color x:Key="AccentPurpleColor">#FF6D3BFF</Color>
  <Color x:Key="AccentVioletColor">#FF9E84F0</Color>
  <Color x:Key="AccentGreenColor">#FF2DB57F</Color>
  <Color x:Key="AccentAmberColor">#FFD69A2E</Color>
  <Color x:Key="DangerPinColor">#FFE45D75</Color>

  <!-- Theme accent (overhaul Task 9): the single, preset-driven accent. Defaults to the sharp-dark
       cyan as a markup fallback; ThemeResourceApplier replaces the AccentPrimary brushes below with
       the chosen accent and derived hover color at startup. AccentCyan/AccentCyanLight remain defined
       as compatibility aliases (the fixed cyan swatch + any markup that still names them). -->
  <Color x:Key="AccentPrimaryColor">#FF2BAED0</Color>
  <Color x:Key="AccentPrimaryLightColor">#FF51BDD8</Color>

  <!-- Derived accent state seeds (theme-v2 Phase B / Task 4): cyan under the sharp-dark profile, the
       default theme. ThemeResourceApplier replaces these from ThemeColors.DeriveAccentSet at startup
       and on accent change. OnAccentPressed re-picks the foreground for the darker pressed fill (CON-1)
       — dark here because cyan's pressed stays bright. AccentPrimaryLight aliases AccentHover. -->
  <Color x:Key="AccentHoverColor">#FF51BDD8</Color>
  <Color x:Key="AccentPressedColor">#FF2492AF</Color>
  <Color x:Key="AccentBorderColor">#FF40B6D5</Color>
  <Color x:Key="AccentShellTintColor">#FF12343F</Color>
  <!-- Toolbar glyph color at the DEFAULT accent intensity (50). Replaced at runtime by
       ThemeResourceApplier; this seed covers design time and the pre-Apply instant, so it must BE the
       derived default or a fresh launch flashes the wrong glyph color. Pinned by
       XamlInvariantTests.Colors_xaml_accent_seeds_match_the_default_derived_set_REQ_UI_01 — do not
       hand-edit; take the value the derivation produces. -->
  <Color x:Key="AccentChromeGlyphColor">#FF2BAED0</Color>
  <Color x:Key="OnAccentColor">#FF06141A</Color>
  <Color x:Key="OnAccentHoverColor">#FF06141A</Color>
  <Color x:Key="OnAccentPressedColor">#FF06141A</Color>
  <!-- Danger-fill text, picked by contrast per preset like OnAccent (polish review 2026-09-10 F-1);
       the seed is the sharp-dark derivation, pinned by XamlInvariantTests.Danger_button_text_reads_on_the_danger_fill. -->
  <Color x:Key="OnDangerColor">#FF06141A</Color>
  <Color x:Key="DangerHoverColor">#FFE77086</Color>
  <!-- Checked-toggle wash: the presentation accent at ThemeColors.CheckedWashAlpha (polish review
       2026-09-10 F-7). Replaced at runtime; the seed IS the derived default (same seed gate as above). -->
  <Color x:Key="AccentCheckedWashColor">#2A2BAED0</Color>
  <Color x:Key="AccentCheckedGlyphColor">#FF2BAED0</Color>
  <!-- Background room tones (docs/Theme_Preset_Differences.md) at the default accent intensity (50): the video
       letterbox and the washed window background. Same rule as the glyph seed above: the values
       ARE the derived defaults (pinned by the same XamlInvariantTests seed gate) — do not
       hand-edit; take what the derivation produces. -->
  <Color x:Key="AccentLetterboxColor">#FF010506</Color>
  <Color x:Key="AppBackgroundWashColor">#FF06090D</Color>
  <Color x:Key="PopoutAccentEdgeColor">#8040B6D5</Color>
  <!-- Profile dropdown row wash alpha at the default theme (sharp-dark SubtleAlpha). Replaced by
       ThemeResourceApplier with the active theme's value. -->
  <sys:Byte x:Key="ProfileRowWashAlpha">34</sys:Byte>

  <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBase" Color="{StaticResource SurfaceBaseColor}" />
  <SolidColorBrush x:Key="SurfaceRaised" Color="{StaticResource SurfaceRaisedColor}" />
  <SolidColorBrush x:Key="SurfaceHover" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="BorderSubtle" Color="{StaticResource BorderSubtleColor}" />
  <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextPrimary" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondary" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="AccentCyan" Color="{StaticResource AccentCyanColor}" />
  <SolidColorBrush x:Key="AccentCyanLight" Color="{StaticResource AccentCyanLightColor}" />
  <SolidColorBrush x:Key="AccentPurple" Color="{StaticResource AccentPurpleColor}" />
  <SolidColorBrush x:Key="AccentViolet" Color="{StaticResource AccentVioletColor}" />
  <SolidColorBrush x:Key="AccentGreen" Color="{StaticResource AccentGreenColor}" />
  <SolidColorBrush x:Key="AccentAmber" Color="{StaticResource AccentAmberColor}" />
  <SolidColorBrush x:Key="DangerPin" Color="{StaticResource DangerPinColor}" />

  <!-- Default (cyan) seeds. ThemeResourceApplier REPLACES these dictionary entries at startup (and on
       accent change) with the chosen accent; every consumer references them via DynamicResource and
       re-resolves. The seeds keep the design-time look correct and cover the pre-Apply instant. -->
  <SolidColorBrush x:Key="AccentPrimary" Color="{StaticResource AccentPrimaryColor}" />
  <SolidColorBrush x:Key="AccentPrimaryLight" Color="{StaticResource AccentPrimaryLightColor}" />
  <SolidColorBrush x:Key="AccentHover" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressed" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="AccentBorder" Color="{StaticResource AccentBorderColor}" />
  <SolidColorBrush x:Key="AccentShellTint" Color="{StaticResource AccentShellTintColor}" />
  <SolidColorBrush x:Key="AccentChromeGlyph" Color="{StaticResource AccentChromeGlyphColor}" />
  <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="OnAccentHover" Color="{StaticResource OnAccentHoverColor}" />
  <SolidColorBrush x:Key="DangerHover" Color="{StaticResource DangerHoverColor}" />
  <SolidColorBrush x:Key="OnAccentPressed" Color="{StaticResource OnAccentPressedColor}" />
  <SolidColorBrush x:Key="OnDanger" Color="{StaticResource OnDangerColor}" />
  <SolidColorBrush x:Key="AccentCheckedWash" Color="{StaticResource AccentCheckedWashColor}" />
  <SolidColorBrush x:Key="AccentCheckedGlyph" Color="{StaticResource AccentCheckedGlyphColor}" />
  <SolidColorBrush x:Key="AccentLetterbox" Color="{StaticResource AccentLetterboxColor}" />
  <SolidColorBrush x:Key="AppBackgroundWash" Color="{StaticResource AppBackgroundWashColor}" />
  <SolidColorBrush x:Key="PopoutAccentEdge" Color="{StaticResource PopoutAccentEdgeColor}" />

  <!-- Semantic corner-radius tokens (docs/Theme_Preset_Differences.md): theme-owned rounding, seeded with the
       sharp-dark profile. ThemeResourceApplier replaces every entry from the active preset's
       ThemeRadii (plus the user's corner-style override); control consumers reference them via
       DynamicResource. Deliberately NOT one universal radius — a popout frame, a button, a
       tooltip, and a scrollbar thumb do not want the same shape. RadiusPopoutFrame is consumed by
       the native large-Round window-region path; the main-frame/title-bar/thumbnail tokens remain
       forward-looking seams for future internal shell styling. -->
  <CornerRadius x:Key="RadiusMainWindowFrame">2</CornerRadius>
  <CornerRadius x:Key="RadiusPopoutFrame">2</CornerRadius>
  <CornerRadius x:Key="RadiusTitleBar">2,2,0,0</CornerRadius>
  <CornerRadius x:Key="RadiusButton">3</CornerRadius>
  <CornerRadius x:Key="RadiusIconButton">3</CornerRadius>
  <CornerRadius x:Key="RadiusInput">3</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">2</CornerRadius>
  <CornerRadius x:Key="RadiusPopup">4</CornerRadius>
  <CornerRadius x:Key="RadiusThumbnail">2</CornerRadius>
  <CornerRadius x:Key="RadiusSwatch">4</CornerRadius>
  <CornerRadius x:Key="RadiusScrollbarThumb">3</CornerRadius>
  <CornerRadius x:Key="RadiusToolTip">4</CornerRadius>

  <!-- Temporary compatibility aliases while styles migrate (docs/Theme_Preset_Differences.md): kept as separate
       entries (NOT resource-to-resource references) and updated by ThemeResourceApplier alongside
       the semantic tokens (Control follows Input, Button follows Button). -->
  <CornerRadius x:Key="ControlCornerRadius">3</CornerRadius>
  <CornerRadius x:Key="ButtonCornerRadius">3</CornerRadius>

  <!-- Density tokens (docs/Theme_Preset_Differences.md): theme-owned control sizing,
       seeded with the sharp-dark (default) profile. ThemeResourceApplier replaces every entry from the
       active preset's ThemeDensity; control consumers reference them via DynamicResource and migrate to
       the tokens in the density-consumer pass. Heights/sizes are Double; paddings + the uniform default
       border are Thickness (a BorderThickness/Padding consumer needs a Thickness struct, not a string). -->
  <sys:Double x:Key="DensityControlHeight">30</sys:Double>
  <sys:Double x:Key="DensityIconButtonSize">30</sys:Double>
  <sys:Double x:Key="DensityScrollbarThickness">8</sys:Double>
  <Thickness x:Key="DensityButtonPadding">10,5</Thickness>
  <Thickness x:Key="DensityInputPadding">8,0</Thickness>
  <Thickness x:Key="DensityMenuItemPadding">8,5</Thickness>
  <Thickness x:Key="DensityPresetChipPadding">8,0</Thickness>
  <Thickness x:Key="DensityToolTipPadding">7,4</Thickness>
  <!-- Uniform default stroke weight (theme-v2: constant 1 across all three v2 themes until border
       weight earns its own pixel-snapping/layout-rounding gate). -->
  <Thickness x:Key="BorderThicknessDefault">1</Thickness>

  <!-- Inner elevation (docs/Theme_Preset_Differences.md): the popup/panel drop-shadow.
       Sharp Dark (default) is flat — both seed as x:Null so the design-time / pre-Apply Effect is null,
       exactly the value the applier writes for sharp-dark. ThemeResourceApplier replaces these with
       frozen DropShadowEffects for Minimal and Soft Glass. Inner-only; never an outer-window glow. -->
  <x:Null x:Key="ElevationPopup" />
  <x:Null x:Key="ElevationPanel" />

</ResourceDictionary>
