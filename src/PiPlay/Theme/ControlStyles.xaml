<!--
  PiPlay control styles - dark, minimal, utility-first (spec section 5).
  Soft rounded rectangles, high-contrast controls, low-glow cyan/purple accents.
  Pin/Fade active state defaults to AccentCyan and can be overridden per control (spec 6.3).

  Theme-controlled values (palette brushes + Radius* corner tokens) are referenced via
  DynamicResource: ThemeResourceApplier REPLACES those dictionary entries on theme change and
  every realized control re-resolves live. Fixed alias brushes (AccentCyan etc.) stay Static.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:theme="clr-namespace:PiPlay.Theme">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Colors.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <theme:ContrastBrushConverter x:Key="ContrastBrushConverter" />
  <theme:AccentWashBrushConverter x:Key="AccentWashBrushConverter" />

  <!-- An inset ring stays visible inside rounded windows and clipped toolbar rows. -->
  <Style x:Key="KeyboardFocusRing" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="2" BorderBrush="{DynamicResource TextPrimary}" BorderThickness="2"
                  CornerRadius="{DynamicResource RadiusButton}" IsHitTestVisible="False" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Horizontal settings slider: retain native Track, range commands and keyboard behavior. -->
  <Style x:Key="DarkSlider" TargetType="Slider">
    <Setter Property="Height" Value="28" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid Background="Transparent" Margin="0,2">
            <Border Height="4" VerticalAlignment="Center" CornerRadius="{DynamicResource RadiusScrollbarThumb}"
                    Background="{DynamicResource BorderStrong}" />
            <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton">
                      <Grid Background="Transparent">
                        <Border Height="4" VerticalAlignment="Center" CornerRadius="{DynamicResource RadiusScrollbarThumb}"
                                Background="{DynamicResource AccentPrimary}" />
                      </Grid>
                    </ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="20" Height="24">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Grid Background="Transparent">
                        <Ellipse x:Name="Knob" Width="14" Height="14" Fill="{DynamicResource TextPrimary}"
                                 Stroke="{DynamicResource SurfaceBase}" StrokeThickness="2" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentPrimary}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                          <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource AccentPrimary}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                  <RepeatButton.Template>
                    <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
                  </RepeatButton.Template>
                </RepeatButton>
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Base text -->
  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
  </Style>

  <!-- Generic dark button (rounded, hover surface) -->
  <Style TargetType="Button" x:Key="DarkButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="{DynamicResource DensityButtonPadding}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusButton}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Primary action button (e.g. Pop out video): the accent is the fill, not just an outline.
       OnAccent / OnAccentPressed are generated from the chosen accent so arbitrary user colors get
       the best dark/white foreground. -->
  <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource DarkButton}">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    <Setter Property="TextOptions.TextHintingMode" Value="Fixed" />
    <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusButton}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              TextOptions.TextFormattingMode="Display"
                              TextOptions.TextHintingMode="Fixed"
                              TextOptions.TextRenderingMode="Grayscale"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHover}" />
            </Trigger>
            <!-- Pressed wins over hover (IsPressed implies IsMouseOver). -->
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentPressed}" />
              <Setter Property="Foreground" Value="{DynamicResource OnAccentPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Destructive action button (e.g. the Clear browser data confirm): red fill, white text. -->
  <Style TargetType="Button" x:Key="DangerButton" BasedOn="{StaticResource DarkButton}">
    <Setter Property="Background" Value="{DynamicResource DangerPin}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusButton}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Opacity" Value="0.88" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Chrome icon button: 32x32 hit target, transparent, hover surface, rounded.
       Set Content to a glyph (Segoe Fluent / MDL2) or short text. -->
  <Style TargetType="Button" x:Key="IconButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
    <Setter Property="Width" Value="{DynamicResource DensityIconButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource DensityIconButtonSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusIconButton}">
            <!-- Render the glyph through an in-template TextBlock with the icon font set here
                 (template-property precedence), so the app-wide implicit TextBlock style cannot
                 reset it to a non-icon font and drop the glyph to a .notdef box (REQ-UI-02). -->
            <TextBlock Text="{TemplateBinding Content}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Close icon button: red (DangerPin) hover -->
  <!-- Toolbar chrome that carries the app accent (roadmap P2 + accent reach, 2026-07-14).
       Only the FUNCTIONAL toolbar row uses this - Back/Reload/Home and the profile actions. The caption
       row (Settings/Minimize/Maximize/Close) deliberately stays neutral on plain IconButton: the accent
       shell-tint wash already sits BEHIND the caption row, so accenting those glyphs too would put
       accent on accent-tint and is exactly where contrast dies. Close additionally keeps its red hover.
       AccentPrimary is already contrast-corrected for presentation (EnsureContrast vs SurfaceHover), so
       even a very dark profile color leaves these glyphs legible. Pinned by XamlInvariantTests. -->
  <Style TargetType="Button" x:Key="AccentIconButton" BasedOn="{StaticResource IconButton}">
    <Setter Property="Foreground" Value="{DynamicResource AccentChromeGlyph}" />
  </Style>

  <Style TargetType="Button" x:Key="CloseIconButton" BasedOn="{StaticResource IconButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusIconButton}">
            <TextBlock Text="{TemplateBinding Content}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource DangerPin}" />
              <Setter Property="Foreground" Value="White" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Pin/Fade toggle: active = configurable glyph + subtle active border. -->
  <Style TargetType="ToggleButton" x:Key="PinToggle">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
    <Setter Property="Width" Value="{DynamicResource DensityIconButtonSize}" />
    <Setter Property="Height" Value="{DynamicResource DensityIconButtonSize}" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="ToolTip" Value="Pin (keep on top)" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="theme:ToggleAccent.CheckedBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="{DynamicResource RadiusIconButton}" BorderThickness="1">
            <TextBlock Text="{TemplateBinding Content}"
                       FontFamily="{TemplateBinding FontFamily}"
                       FontSize="{TemplateBinding FontSize}"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dark URL / text input. Conventional single-line dark textbox: a rounded Border hosting the
       stretched PART_ContentHost, with the line vertically centred. The text-clipping seen at
       fractional DPI came from the window-level UseLayoutRounding=True (removed on both windows),
       not from this template. (UI-CHK-5) -->
  <Style TargetType="TextBox" x:Key="DarkTextBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="{DynamicResource DensityControlHeight}" />
    <Setter Property="Padding" Value="{DynamicResource DensityInputPadding}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusInput}" Padding="{TemplateBinding Padding}">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dark scrollbar (implicit): so an overflowing dropdown/popup never exposes the light
       system scrollbar inside dark chrome (REQ-UI-01). Thin, rounded thumb, no arrow buttons. -->
  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="{DynamicResource DensityScrollbarThickness}" />
    <Setter Property="MinWidth" Value="{DynamicResource DensityScrollbarThickness}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border CornerRadius="{DynamicResource RadiusScrollbarThumb}" Margin="2,0"
                              Background="{DynamicResource SurfaceHover}" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="{DynamicResource DensityScrollbarThickness}" />
        <Setter Property="MinHeight" Value="{DynamicResource DensityScrollbarThickness}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track">
                  <Track.Thumb>
                    <Thumb>
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Border CornerRadius="{DynamicResource RadiusScrollbarThumb}" Margin="0,2"
                                  Background="{DynamicResource SurfaceHover}" />
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                  </Track.IncreaseRepeatButton>
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                  </Track.DecreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Dropdown item: dark, rounded hover. Defined before DarkComboBox so it can be referenced. -->
  <Style TargetType="ComboBoxItem" x:Key="DarkComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="{DynamicResource DensityMenuItemPadding}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource RadiusPopup}" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceRaised}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dark combo box for profiles: dark closed control AND dark popup + items, with an
       intentional empty state (no profiles yet) rather than a blank light box (REQ-UI-01). -->
  <Style TargetType="ComboBox" x:Key="DarkComboBox">
    <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusRing}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="{DynamicResource DensityControlHeight}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                          BorderThickness="{DynamicResource BorderThicknessDefault}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="bd" Background="{DynamicResource SurfaceRaised}"
                          BorderBrush="Transparent"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="{DynamicResource RadiusInput}">
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,9,0" Text="&#xE70D;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>

            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              TextElement.Foreground="{TemplateBinding Foreground}"
                              Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left" />

            <TextBlock x:Name="Placeholder" Text="Profiles" Margin="10,0,28,0"
                       VerticalAlignment="Center" IsHitTestVisible="False"
                       FontFamily="Segoe UI" FontSize="13"
                       Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed" />

            <Popup x:Name="Popup" Placement="Bottom" Focusable="False" AllowsTransparency="True"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
              <!-- Inner elevation (theme-v2 Task 7): the dropdown lives in a real Popup HWND (no WebView2),
                   so a DropShadowEffect here is airspace-safe (FEAS-04). The right/bottom margin gives the
                   315-degree shadow inset room inside the transparent popup so it is not clipped flush; that
                   room is transparent and invisible under Sharp Dark's null elevation. Exact inset is
                   PROVISIONAL pending deployed-Stable visual QA. -->
              <Border x:Name="DropDownBorder" MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4,20,20"
                      Background="{DynamicResource SurfaceBase}" BorderBrush="{DynamicResource BorderSubtle}"
                      BorderThickness="{DynamicResource BorderThicknessDefault}" CornerRadius="{DynamicResource RadiusPopup}"
                      Effect="{DynamicResource ElevationPopup}">
                <Grid>
                  <ScrollViewer x:Name="DropDownScroll" Margin="4"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                    <StackPanel IsItemsHost="True"
                                KeyboardNavigation.DirectionalNavigation="Contained" />
                  </ScrollViewer>
                  <TextBlock x:Name="EmptyText" Text="No saved profiles yet" Margin="12,10"
                             FontFamily="Segoe UI" FontSize="12"
                             Foreground="{DynamicResource TextSecondary}" Visibility="Collapsed" />
                </Grid>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SelectedIndex" Value="-1">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="HasItems" Value="False">
              <Setter TargetName="DropDownScroll" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="EmptyText" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Semantic dark menu primitives for compact command groups. Keep these as real ContextMenu /
       MenuItem controls so arrow-key navigation, access keys, Escape dismissal, and UI Automation
       behavior remain native rather than being reimplemented in a custom Popup. -->
  <Style TargetType="MenuItem" x:Key="DarkMenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="{DynamicResource DensityMenuItemPadding}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="bd" Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource RadiusPopup}"
                  Padding="{TemplateBinding Padding}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ContentPresenter Grid.Column="0" ContentSource="Icon"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Margin="0,0,8,0" />
              <ContentPresenter Grid.Column="1" ContentSource="Header"
                                RecognizesAccessKey="True" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}"
                         Margin="18,0,0,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondary}" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ContextMenu" x:Key="DarkContextMenu">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBase}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource DarkMenuItem}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusPopup}"
                  Padding="{TemplateBinding Padding}">
            <ScrollViewer CanContentScroll="True"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- App-wide dark tooltip (implicit: applies to every ToolTip). Placed below the control so
       it does not occlude what it describes, e.g. caption buttons (REQ-UI-01). -->
  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThicknessDefault}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Placement" Value="Bottom" />
    <Setter Property="HorizontalOffset" Value="0" />
    <Setter Property="VerticalOffset" Value="4" />
    <Setter Property="HasDropShadow" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource RadiusToolTip}" Padding="{DynamicResource DensityToolTipPadding}">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
